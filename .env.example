# ---------------------------------------------------------------------------
# VaporVault configuration
#
# Copy to `.env` for Docker Compose, or `.env.local` for `npm run dev`.
# Generate secrets with:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# Redis connection string. Use rediss:// to enable TLS.
# For Docker Compose this is overridden to point at the bundled container.
REDIS_URL=redis://127.0.0.1:6379

# Password for the bundled Redis container (Compose only). Empty so Compose fails loudly
# rather than starting with a password that is published in this repository.
#   REDIS_PASSWORD=$(openssl rand -hex 24)
REDIS_PASSWORD=

# REQUIRED IN PRODUCTION. 32+ characters of high entropy.
# Sub-keys are derived from this for two purposes:
#   - hashing secret ids into Redis keys, so a stolen Redis snapshot cannot be
#     turned back into working share links;
#   - pseudonymising client IPs in rate-limit keys.
# Rotating it makes every outstanding link unresolvable. That is a safe failure,
# but it is not reversible.
#
# Left empty on purpose. The app refuses to start in production without it, and it also
# rejects placeholder-looking values, so this template cannot be deployed as-is.
#   APP_SECRET=$(openssl rand -hex 32)
APP_SECRET=

# REQUIRED IN PRODUCTION. Comma-separated origins allowed to call the API.
# This is the CSRF allow-list; it must match how users actually reach the app.
#
# On Vercel this is optional: the deployment's own production, preview and branch URLs are
# added automatically from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL / VERCEL_BRANCH_URL,
# which the platform sets and a caller cannot influence. Set it anyway if you serve the app
# from a custom domain that is not the project's shortest production domain.
ALLOWED_ORIGINS=http://localhost:3000

# --- Client attribution for rate limiting ----------------------------------
# The number of reverse proxies YOU operate between the internet and this app.
#
# 0 (default) means X-Forwarded-For is ignored entirely, because a directly
# exposed app receives whatever value the client chose to send. All callers then
# share one rate-limit pool: still bounded, but coarse.
#
# Set this to a non-zero value ONLY if that many proxies really are in front of
# the app. Claiming a proxy that does not exist lets any client mint unlimited
# rate-limit identities by sending its own header.
#
# On Vercel, use 1: Vercel overwrites X-Forwarded-For with the real client address
# and refuses to forward external values, specifically to prevent IP spoofing.
TRUSTED_PROXY_HOPS=0

# Header carrying the client address. If your proxy sets a single-value header
# that it always overwrites (nginx `X-Real-IP`, Cloudflare `CF-Connecting-IP`),
# point this at that header and use TRUSTED_PROXY_HOPS=1.
#
# On Vercel prefer x-real-ip: it mirrors x-forwarded-for but, unlike it, cannot be
# clobbered by another proxy layered on top of Vercel.
CLIENT_IP_HEADER=x-forwarded-for

# --- Rate limits (per client, unless noted) --------------------------------
RATE_LIMIT_CREATE_PER_MINUTE=10
RATE_LIMIT_CREATE_PER_HOUR=60
RATE_LIMIT_REVEAL_PER_MINUTE=30
RATE_LIMIT_REVEAL_PER_HOUR=200

# Whole-instance ceilings, applied on top of the per-client limits.
RATE_LIMIT_GLOBAL_CREATE_PER_MINUTE=300
RATE_LIMIT_GLOBAL_REVEAL_PER_MINUTE=900

# Shared bucket used when no trustworthy client address is available.
RATE_LIMIT_UNATTRIBUTED_PER_MINUTE=120

# --- Redis timeouts --------------------------------------------------------
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_CONNECT_TIMEOUT_MS=5000

# --- Local ports (Compose only) -------------------------------------------
APP_PORT=3000
REDIS_MAXMEMORY=256mb
